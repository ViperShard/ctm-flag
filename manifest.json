{
  "manifest_version": 3,
  "name": "CTM Tag",
  "version": "1.1.1",
  "description": "Tag Call Tracking Metrics calls with shared notes your whole team sees in real time.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.calltrackingmetrics.com/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "ctm-tag@ctmtag.local",
      "strict_min_version": "115.0"
    }
  }
}
